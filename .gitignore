# Personal data and raw pulls never leave the machine / Drive
clients/*/consents/*
!clients/*/consents/.gitkeep
clients/*/data/*
!clients/*/data/.gitkeep
clients/*/character-sheet/*.png
clients/*/character-sheet/*.jpg
clients/*/character-sheet/*.mp4
.env*
node_modules/
.claude/settings.local.json
__pycache__/

# Baseline and report renders carry revenue: stay on disk and in Drive, never in git (guardrails 12)
clients/*/deliverables/*-Baseline-*
