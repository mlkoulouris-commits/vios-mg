{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vios client status",
  "description": "One file per client at clients/<slug>/status.json. Written by the Vios skills at the end of every step, read by the /vios front door and by scripts/clients.py. The deliverables map mirrors the client's ClickUp '<Client> — Deliverables' list one to one.",
  "type": "object",
  "required": ["client", "name", "approver", "proposal", "marketing_loop", "current_stage", "stages", "blockers", "next_action", "updated"],
  "properties": {
    "client": { "type": "string", "description": "folder slug under clients/" },
    "name": { "type": "string" },
    "approver": { "type": "string", "description": "named person or 'to confirm' (guardrails 10)" },
    "account_manager": { "type": "string" },
    "proposal": {
      "type": "object",
      "properties": {
        "version": { "type": "integer" },
        "status": { "enum": ["not sent", "sent", "signed", "declined", "superseded"] },
        "doc": { "type": "string", "description": "Claude Doc link or repo path" },
        "pdf": { "type": "string", "description": "repo path of the client deliverables sheet" }
      }
    },
    "marketing_loop": { "enum": ["in", "out", "to confirm"] },
    "baseline": {
      "type": "object",
      "description": "The month-0 measurement (templates/client/data/baseline.md), made by vios-engagement-setup step 7 before any deliverable; the monthly report compares against it.",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["not started", "in progress", "measured", "partial"] },
        "date": { "type": "string", "description": "measurement date YYYY-MM-DD; the period is the three full months before it" },
        "file": { "type": "string", "description": "repo path, clients/<slug>/data/baseline-YYYY-MM.md" },
        "missing": { "type": "array", "items": { "type": "string" }, "description": "rows that read 'to confirm'" }
      }
    },
    "current_stage": { "enum": ["0 intake", "1 Brand", "2 Map", "3 Design", "4 Training", "closed"] },
    "stages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "scope": { "enum": ["in", "out", "revision", "to confirm"] },
          "status": { "enum": ["not started", "in progress", "review", "signed", "done"] },
          "deliverables": {
            "type": "object",
            "description": "key = deliverable name as the practice ships it",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "status": { "enum": ["not started", "draft", "review", "approved", "done"] },
                "file": { "type": "string" },
                "pdf": { "type": "string" },
                "clickup": { "type": "string", "description": "task id" },
                "due": { "type": "string", "format": "date" }
              }
            }
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["what", "holds"],
        "properties": {
          "what": { "type": "string" },
          "holds": { "type": "string", "description": "who has the answer" },
          "open_fact": { "type": "integer", "description": "row in open-facts.md" },
          "blocks": { "type": "string" }
        }
      }
    },
    "next_action": {
      "type": "object",
      "required": ["skill", "what"],
      "properties": { "skill": { "type": "string" }, "what": { "type": "string" } }
    },
    "updated": { "type": "string", "format": "date" }
  }
}
